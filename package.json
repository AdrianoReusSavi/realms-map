{
  "name": "minecraft-map",
  "version": "1.0.0",
  "private": true,
  "description": "Source-agnostic Minecraft map renderer with Realms and local world sources",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "render": "npm run build && node dist/packages/local/src/cli.js",
    "setup": "npm run build && tsx packages/realms/src/setup.ts",
    "update": "npm run build && tsx packages/realms/src/update.ts",
    "test": "vitest run"
  },
  "license": "MIT"
}